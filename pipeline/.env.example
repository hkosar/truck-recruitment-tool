# Copy to .env.local for local dev (never commit .env.local -- see .gitignore).
# Local dev loading: `set -a; source .env.local; set +a` before `npm run dev`, or invoke
# node directly with `node --env-file=.env.local node_modules/.bin/tsx src/run.ts ...`.
# In Render, set these in the Cron Job's Environment tab instead of shipping this file.
# See pipeline/README.md and src/config.ts (zod schema = source of truth for what's valid).

# ---- Supabase ---------------------------------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# service_role key (Project Settings -> API). NEVER the anon key -- this pipeline bypasses
# RLS by design (Part A D9: it is the only writer of sync-owned carrier columns). Treat as
# a secret; never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, SESSION pooler (port 5432 -- Project Settings ->
# Database -> Connection string -> "Session pooler"). Needed for COPY / staging tables /
# set-based upserts; PostgREST can't do 150-220k-row merges (Part B §6.1).
# Example shape: postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# ---- Socrata (data.transportation.gov) ---------------------------------------------
# Free app token: https://dev.socrata.com/register -- lifts anonymous IP throttling to
# 1,000 req/rolling-hour (dev.socrata.com/docs/app-tokens.html). Owner prerequisite,
# 00-master-plan.md §3 "Before M2".
SOCRATA_APP_TOKEN=

# ---- Census Bureau batch geocoder (no API key required) ----------------------------
# Sensible defaults baked into config.ts; override only if the Census benchmark changes
# or you want a smaller CENSUS_BATCH_MAX_RECORDS for a cheap local smoke test.
# CENSUS_GEOCODER_BASE_URL=https://geocoding.geo.census.gov/geocoder
# CENSUS_GEOCODER_BENCHMARK=Public_AR_Current
# CENSUS_BATCH_MAX_RECORDS=10000
# CENSUS_MAX_BATCHES_PER_RUN=30

# ---- Alerting (Resend; optional until M7) -------------------------------------------
# Set both values after a Resend account and sending domain are verified. Until then, the
# pipeline still runs and relies on Render's native cron failure notification.
# RESEND_API_KEY=
# ALERT_EMAIL=hunter.kosar@gmail.com

# ---- Misc -----------------------------------------------------------------------------
# 'prod' | 'dev' -- labels pipeline_runs.meta and log lines only; does not cap row/page
# counts by itself (use --pages/--batches/--from, see README "Local dev").
PIPELINE_ENV=dev

# NOTE: QCMOBILE_WEBKEY intentionally does not belong in this file. QCMobile per-carrier
# inspection lookups are a Supabase EDGE FUNCTION (qc-fetch), not this cron pipeline --
# see docs/build-plan/01-architecture.md reconciliation amendment #16.
