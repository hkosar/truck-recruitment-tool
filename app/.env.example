# Copy to .env.local (git-ignored) and fill in real values for local dev.
# Render deploy: build-time VITE_ keys only; server settings are listed below by name.

# --- Sign-in server (server/main.ts; NOT exposed to the browser) ----------------
# The browser no longer talks to Supabase directly: no Supabase URL or key belongs in this
# file. The Node server reads these from its own environment (never from a VITE_ variable):
#   APP_ORIGIN, DATABASE_URL (recruiter_app login), KEY_LINKS, KEY_SESSIONS, KEY_RATE,
#   EMAIL_MODE (test|production), SENDGRID_API_KEY, SENDGRID_FROM_ADDRESS,
#   SENDGRID_WEBHOOK_VERIFICATION_KEY, MAINTENANCE_MODE, STAGING_BANNER, TRUSTED_PROXY_HOPS.
# development | staging | production. Staging enables persistent nonproduction labeling.
VITE_APP_ENV=development

# --- Google Maps -------------------------------------------------------------
# Browser key, HTTP-referrer locked to this app's domain(s). Loader libraries
# are ["marker","geometry"] ONLY — no "places" (01-architecture.md amendment
# #12: routing is Google Routes API `computeRoutes` REST calls, not the legacy
# Directions/Places JS libraries; the same browser key covers those requests).
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key
# Vector Map ID (required for AdvancedMarkerElement); cloud style should only
# reduce POI density — basemap stays default roadmap skin (F24).
VITE_GOOGLE_MAPS_MAP_ID=your-map-id

# --- Map provider switch ------------------------------------------------------
# google (primary, built now) | maplibre (fallback adapter, pending decision —
# 02-frontend-spec.md §2). Selects map/<provider>/ at build/run time.
VITE_MAPS_PROVIDER=google
